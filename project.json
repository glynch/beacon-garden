{
  "$schema": "https://jscene3d.org/schemas/project-1.json",
  "schemaVersion": 1,
  "identity": {
    "id": "io.github.glynch.beacon-garden",
    "name": "Beacon Garden",
    "version": "0.1.0",
    "description": "A small interactive garden proving JScene3D project composition.",
    "icon": "branding/beacon-garden.icns"
  },
  "engine": {
    "requires": ">=0.1.0-SNAPSHOT <0.2.0",
    "authoredWith": "0.1.0-SNAPSHOT"
  },
  "legal": {
    "projectLicense": {
      "expression": "Apache-2.0",
      "file": "LICENSE"
    }
  },
  "runtime": {
    "applicationExtension": "io.github.glynch.beacon-garden",
    "entryScene": "worlds/garden.world.json",
    "inputMap": "config/input-map.json"
  },
  "extensions": [
    {
      "id": "io.github.glynch.beacon-garden",
      "requires": ">=0.1.0 <0.2.0"
    }
  ],
  "assets": [
    {
      "id": "garden-model",
      "type": "io.github.glynch.jscene3d.gltf/source",
      "path": "assets/garden.gltf"
    },
    {
      "id": "beacon-sensor-box",
      "type": "io.github.glynch.jscene3d.physics3d/box-collision-shape-3d",
      "path": "resources/beacon-sensor-box.resource.json"
    },
    {
      "id": "beacon-sensor-sphere",
      "type": "io.github.glynch.jscene3d.physics3d/sphere-collision-shape-3d",
      "path": "resources/beacon-sensor-sphere.resource.json"
    },
    {
      "id": "garden-overlap-target",
      "type": "io.github.glynch.jscene3d.physics3d/box-collision-shape-3d",
      "path": "resources/garden-overlap-target.resource.json"
    }
  ],
  "imports": [
    "imports/garden.import.json"
  ],
  "catalog": {
    "genres": ["exploration"],
    "tags": ["garden", "three-dimensional"],
    "players": {
      "minimum": 1,
      "maximum": 1
    }
  }
}
