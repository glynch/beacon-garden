<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8" />
    <property name="severity" value="error" />
    <module name="RegexpMultiline">
        <property name="format" value="\brecord\s+\w+\s*\([^)]*\[\]" />
        <property name="matchAcrossLines" value="true" />
        <property name="message" value="Arrays must not be record components; use an immutable class with deliberate equality semantics." />
    </module>
    <module name="SuppressionSingleFilter">
        <property name="files" value="^(?!.*[/\\]physics[/\\]shapes[/\\]).*$" />
        <property name="id" value="physicsShapeDirectFiniteValidation" />
    </module>
    <module name="SuppressionSingleFilter">
        <property name="files" value=".*[/\\]src[/\\]main[/\\].*" />
        <property name="id" value="testsUseTempDir" />
    </module>
    <module name="TreeWalker">
        <module name="ArrayTypeStyle" />
        <module name="AvoidStarImport" />
        <module name="CovariantEquals" />
        <module name="DefaultComesLast" />
        <module name="EmptyCatchBlock">
            <property name="commentFormat" value="(?s).+" />
            <property name="exceptionVariableName" value="^(ignored|expected)$" />
        </module>
        <module name="EqualsHashCode" />
        <module name="FallThrough" />
        <module name="IllegalCatch">
            <property name="illegalClassNames" value="java.lang.Error, java.lang.Throwable" />
        </module>
        <module name="IllegalImport">
            <property name="illegalPkgs" value="com.sun, jdk.internal, sun" />
        </module>
        <module name="InnerAssignment" />
        <module name="IllegalIdentifierName">
            <property name="format" value="(?i)^(?!(when|record|yield|var|permits|sealed|open|transitive|_)$|(.*\$)).+$" />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//DOT[not(parent::DOT) and not(ancestor::IMPORT) and not(ancestor::STATIC_IMPORT) and not(ancestor::MODULE_DEF) and (not(ancestor::PACKAGE_DEF) or ancestor::ANNOTATION) and (descendant::IDENT[@text='java'] or descendant::IDENT[@text='javax'] or descendant::IDENT[@text='org'] or descendant::IDENT[@text='com'] or descendant::IDENT[@text='io'] or descendant::IDENT[@text='de'])]" />
            <message key="matchxpath.match" value="Use an import instead of a fully qualified class name in Java code." />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//CTOR_DEF[(./MODIFIERS/LITERAL_PUBLIC or ./MODIFIERS/LITERAL_PROTECTED) and ./SLIST[count(*) = 1]] | //METHOD_DEF[(./MODIFIERS/LITERAL_PUBLIC or ./MODIFIERS/LITERAL_PROTECTED) and ./SLIST[count(*) = 1]]" />
            <message key="matchxpath.match" value="Public and protected methods and constructors must not have an empty body." />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//LAMBDA[ancestor::METHOD_CALL[descendant::IDENT[@text='assertThatThrownBy' or @text='assertThrows']]][count(.//METHOD_CALL | .//LITERAL_NEW) &gt; 1]" />
            <message key="matchxpath.match" value="Prepare arguments before an exception assertion so its lambda contains only the invocation under test." />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//METHOD_DEF[count(.//METHOD_CALL[./IDENT[starts-with(@text, 'assertThat') or @text='assertThrows']]) &gt; 24]" />
            <message key="matchxpath.match" value="Split tests containing more than 24 assertions into focused test methods." />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//METHOD_DEF[./IDENT[@text='requirePositiveFinite' or @text='requireNonNegativeFinite']]" />
            <message key="matchxpath.match" value="Use the module or package Preconditions class instead of declaring a local finite-number validation helper." />
        </module>
        <module name="MatchXpath">
            <property name="query" value="//METHOD_CALL[./DOT[./IDENT[@text='Math'] and ./IDENT[@text='min']] and ./ELIST/EXPR//METHOD_CALL[./DOT[./IDENT[@text='Math'] and ./IDENT[@text='max']]]] | //METHOD_CALL[./DOT[./IDENT[@text='Math'] and ./IDENT[@text='max']] and ./ELIST/EXPR//METHOD_CALL[./DOT[./IDENT[@text='Math'] and ./IDENT[@text='min']]]]" />
            <message key="matchxpath.match" value="Use Math.clamp instead of nesting Math.min and Math.max." />
        </module>
        <module name="MissingOverride" />
        <module name="ModifiedControlVariable" />
        <module name="NoFinalizer" />
        <module name="OneTopLevelClass" />
        <module name="ParameterNumber">
            <property name="max" value="7" />
            <property name="ignoreOverriddenMethods" value="true" />
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="physicsShapeDirectFiniteValidation" />
            <property name="format" value="\bFloat\.isFinite\s*\(" />
            <property name="ignoreComments" value="true" />
            <property name="message" value="Physics shapes must use the shared physics Preconditions validation methods." />
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="\b(?:Path\.of|Paths\.get)\s*\(\s*&quot;/tmp(?:/|&quot;)" />
            <property name="ignoreComments" value="true" />
            <property name="message" value="Do not hard-code a system temporary path; tests must use JUnit @TempDir." />
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="testsUseTempDir" />
            <property name="format" value="\b(?:Files\.createTemp(?:File|Directory)|File\.createTempFile)\s*\(" />
            <property name="ignoreComments" value="true" />
            <property name="message" value="Tests must use a JUnit @TempDir instead of creating unmanaged temporary paths." />
        </module>
        <module name="SimplifyBooleanExpression" />
        <module name="SimplifyBooleanReturn" />
        <module name="StringLiteralEquality" />
        <module name="SuperClone" />
        <module name="SuperFinalize" />
    </module>
</module>
