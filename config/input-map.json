{
  "$schema": "https://jscene3d.org/schemas/input-map-1.json",
  "schemaVersion": 1,
  "actions": {
    "pulse": {
      "valueType": "button",
      "bindings": [
        {"device": "keyboard", "control": "SPACE"},
        {"device": "gamepad", "control": "button-south"}
      ]
    },
    "move": {
      "valueType": "axis-2d",
      "bindings": [
        {
          "device": "keyboard",
          "control": "directional",
          "up": "W",
          "down": "S",
          "left": "A",
          "right": "D"
        },
        {"device": "gamepad", "control": "left-stick", "deadZone": 0.15, "invertY": true}
      ]
    },
    "look": {
      "valueType": "axis-2d",
      "bindings": [
        {"device": "mouse", "control": "delta", "scaleX": 0.01, "scaleY": -0.01},
        {"device": "gamepad", "control": "right-stick", "deadZone": 0.15, "invertY": true}
      ]
    }
  }
}
